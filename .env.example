# Production domain, used for canonical URLs and OpenGraph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://osi-regen-placeholder.com

# Email delivery for the consultation form (app/contact/actions.ts).
# Get an API key at https://resend.com/api-keys (free tier is plenty).
RESEND_API_KEY=

# Optional. Defaults to the Resend sandbox sender, which only delivers to the
# address that owns the Resend account. For production, verify a domain in
# Resend and set e.g. "OSI Regenerative Medicine <hello@yourdomain.com>".
RESEND_FROM=
